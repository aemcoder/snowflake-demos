  "strip": [],
  "notes": [
    "hero.sub and hero.claim contain <b> tags — DA cells must use <strong> instead (pipeline strips <b>)",
    "products section: .product-row children are slots; <a class=product-row> itself must NOT have data-slot",
    "goal-card children are slots; <a class=goal-card> itself must NOT have data-slot",
    "res-card children are slots; <a class=res-card> itself must NOT have data-slot",
    "anniversary .anniv-fact:nth-child(4) is a Stardust F-002 placeholder — mark data-slot-skip",
    "social .social__cell placeholder-tag spans are F-002 placeholders — mark data-slot-skip",
